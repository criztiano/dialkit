{
  "name": "tweakers",
  "version": "1.2.0",
  "description": "Real-time parameter tweaking for React, Solid, and Svelte apps",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid/index.d.ts",
        "default": "./dist/solid/index.js"
      },
      "require": {
        "types": "./dist/solid/index.d.cts",
        "default": "./dist/solid/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store/index.d.ts",
        "default": "./dist/store/index.js"
      },
      "require": {
        "types": "./dist/store/index.d.cts",
        "default": "./dist/store/index.cjs"
      }
    },
    "./timeline": {
      "import": {
        "types": "./dist/timeline/index.d.ts",
        "default": "./dist/timeline/index.js"
      },
      "require": {
        "types": "./dist/timeline/index.d.cts",
        "default": "./dist/timeline/index.cjs"
      }
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./curve-composer-core": {
      "types": "./dist/curve-composer-core.d.ts",
      "default": "./dist/curve-composer-core.js"
    },
    "./modulation-core": {
      "types": "./dist/modulation-core.d.ts",
      "default": "./dist/modulation-core.js"
    },
    "./modulation-store": {
      "types": "./dist/modulation-store.d.ts",
      "default": "./dist/modulation-store.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "skills/tweakers-integration"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && npm run build:svelte",
    "build:svelte": "node scripts/gen-theme-css.js && svelte-package -i src/svelte -o dist/svelte && rm -rf .svelte-kit src/store/TweakStore.d.ts src/store/TweakStore.d.ts.map src/color-core.d.ts src/color-core.d.ts.map src/color-palette-store.d.ts src/color-palette-store.d.ts.map src/curve-composer-core.d.ts src/curve-composer-core.d.ts.map src/gradient-core.d.ts src/gradient-core.d.ts.map src/xy-pad-core.d.ts src/xy-pad-core.d.ts.map src/range-slider-core.d.ts src/range-slider-core.d.ts.map src/filter-core.d.ts src/filter-core.d.ts.map src/affordance-core.d.ts src/affordance-core.d.ts.map src/analyser-engine.d.ts src/analyser-engine.d.ts.map src/analyser-core.d.ts src/analyser-core.d.ts.map src/store/TimelineStore.d.ts src/store/TimelineStore.d.ts.map src/store/TimelineUiStore.d.ts src/store/TimelineUiStore.d.ts.map src/timeline-core.d.ts src/timeline-core.d.ts.map src/timeline/adapter.d.ts src/timeline/adapter.d.ts.map src/timeline/index.d.ts src/timeline/index.d.ts.map src/transition-math.d.ts src/transition-math.d.ts.map src/copy-instruction.d.ts src/copy-instruction.d.ts.map src/env.d.ts src/env.d.ts.map src/move-visual-core.d.ts src/move-visual-core.d.ts.map",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.solid.json && tsc --noEmit -p tsconfig.vue.json && node scripts/gen-theme-css.js && svelte-check --tsconfig tsconfig.svelte.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:timeline": "tsx --test src/*.test.ts",
    "snapshot": "node scripts/snapshot-package.mjs"
  },
  "peerDependencies": {
    "motion": ">=11.0.0",
    "motion-v": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "solid-js": ">=1.6.0",
    "svelte": ">=5.8.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "motion-v": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild-plugin-solid": "^0.6.0",
    "motion": "^12.0.0",
    "motion-v": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.3.1",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0"
  },
  "keywords": [
    "react",
    "solid",
    "solidjs",
    "svelte",
    "animation",
    "tweaking",
    "parameters",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/criztiano/tweakers"
  }
}
